# Copie ce fichier en ".env" puis renseigne TON mot de passe PostgreSQL
SECRET_KEY=change-moi-en-production
DATABASE_URL=postgresql://postgres:TON_MOT_DE_PASSE@localhost:5432/rbnb_togo
FLASK_DEBUG=1

# CinetPay (laisser vide = paiement simulé). Clés depuis ton dashboard CinetPay.
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# Cloudinary (laisser vide = photos stockées sur le disque local, à éviter en production).
# Clés depuis ton dashboard Cloudinary (cloudinary.com -> Dashboard).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
